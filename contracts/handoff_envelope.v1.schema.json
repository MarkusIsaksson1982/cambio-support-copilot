{
  "$comment": "What the copilot emits (copilot/core/pipeline.py run() result) and what a chained service receives. masked_text is ALREADY masked; the raw text never crosses the boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "request_type", "plugin_version", "status", "handoff_reasons", "route", "masked_text", "masked_categories", "rule", "model", "output"],
  "properties": {
    "contract_version": {"type": "string", "enum": ["1.0.0"]},
    "request_id": {"type": "string", "minLength": 1},
    "request_type": {"type": "string", "minLength": 1},
    "plugin_version": {"type": "string"},
    "status": {"type": "string", "enum": ["awaiting_approval", "handoff"]},
    "handoff_reasons": {"type": "array", "items": {"type": "string"}},
    "route": {"type": "string"},
    "masked_text": {"type": "string"},
    "masked_categories": {"type": "array", "items": {"type": "string"}},
    "rule": {"type": "object"},
    "model": {"type": "object"},
    "output": {"type": "object"}
  }
}
